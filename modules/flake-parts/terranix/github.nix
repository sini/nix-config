# Terranix: GitHub repository settings as code, applied with OpenTofu. A separate
# workspace and state from DNS and UniFi (./terranix.nix, ./unifi.nix).
#
# First cut: the ATTIC_TOKEN Actions secret on the repos whose CI pushes to the
# attic `ci` cache (services/nix/attic.nix). Its value is the agenix
# `attic-ci-push-token`, decrypted at apply time, so it exists only in agenix and
# in this workspace's encrypted state, never in a message or a log.
#
# Credential: a fine-grained PAT, the one secret here that GitHub issues, so it is
# placed by hand: resource owner `sini`, repository access limited to `repos`
# below, permissions "Secrets: Read and write" (Metadata: read is implied).
#   agenix edit .secrets/env/prod/github-terraform-token.age   # paste the token
# Rotate it the same way when it expires.
#
#   github-plan / github-apply (devshell)
{ lib, ... }:
let
  workdir = "infra/github";
  owner = "sini";
  repos = [
    "xmsg"
    "matrix-xmsg"
    "genie-agent"
  ];
  tokenFile = ".secrets/env/prod/github-terraform-token.age";
  atticTokenFile = ".secrets/env/prod/attic/ci-push-token.age";
in
{
  # The workspace's state passphrase, declared like unifi-state-passphrase.
  den.aspects.github-state-passphrase.age-secrets =
    { environment, ... }:
    {
      age.secrets.github-state-passphrase = {
        rekeyFile = environment.secretPath + "/github-state-passphrase.age";
        intermediary = true;
        generator.script = "rfc3986-secret";
      };
    };

  perSystem =
    { config, pkgs, ... }:
    let
      tf = config.terranix.terranixConfigurations.github;
      inherit (tf.result) scripts;
      github = pkgs.terraform-providers.integrations_github;

      secretsPrelude = ''
        cd "$(git rev-parse --show-toplevel)"
        # Generated by `tofu init` from the nix-provided providers; never carried over.
        rm -f ${workdir}/.terraform.lock.hcl
        identity=$(mktemp)
        trap 'rm -f "$identity"' EXIT
        age-plugin-yubikey -i > "$identity"
        [[ -s $identity ]] || { echo "no YubiKey identity found; plug in the YubiKey" >&2; exit 1; }
        [[ -e ${tokenFile} ]] || { echo "${tokenFile} is absent; see modules/flake-parts/terranix/github.nix" >&2; exit 1; }
        GITHUB_TOKEN=$(age -d -i "$identity" ${tokenFile})
        TF_VAR_attic_ci_push_token=$(age -d -i "$identity" ${atticTokenFile})
        TF_VAR_state_passphrase=$(age -d -i "$identity" .secrets/env/prod/github-state-passphrase.age)
        export GITHUB_TOKEN TF_VAR_attic_ci_push_token TF_VAR_state_passphrase
      '';

      mkGithubCommand =
        name: description: text:
        pkgs.writeShellApplication {
          inherit name;
          meta.description = description;
          runtimeInputs = [
            pkgs.age
            pkgs.age-plugin-yubikey
            pkgs.git
          ];
          text = secretsPrelude + text;
        };
    in
    {
      # Providers come from nixpkgs; required_providers takes the version from the
      # package and the lock file is not committed (./terranix.nix).
      terranix.terranixConfigurations.github = {
        inherit workdir;
        terraformWrapper.package = pkgs.opentofu.withPlugins (_: [ github ]);
        modules = [
          {
            terraform = {
              required_providers.github = {
                source = "integrations/github";
                inherit (github) version;
              };
              backend.local.path = "terraform.tfstate";
              encryption = {
                key_provider.pbkdf2.state.passphrase = "\${var.state_passphrase}";
                method.aes_gcm.state.keys = "\${key_provider.pbkdf2.state}";
                state = {
                  method = "method.aes_gcm.state"; # a bare reference, not an interpolation
                  enforced = true;
                };
                plan = {
                  method = "method.aes_gcm.state";
                  enforced = true;
                };
              };
            };

            variable = {
              state_passphrase = {
                type = "string";
                sensitive = true;
                description = "State and plan encryption passphrase (TF_VAR_state_passphrase)";
              };
              attic_ci_push_token = {
                type = "string";
                sensitive = true;
                description = "The attic `ci` push token (TF_VAR_attic_ci_push_token)";
              };
            };

            # Token from GITHUB_TOKEN.
            provider.github = { inherit owner; };

            resource.github_actions_secret = lib.genAttrs repos (repository: {
              inherit repository;
              secret_name = "ATTIC_TOKEN";
              plaintext_value = "\${var.attic_ci_push_token}";
            });
          }
        ];
      };

      packages = {
        github-plan = mkGithubCommand "github-plan" "OpenTofu plan for the GitHub repository settings" ''
          ${lib.getExe scripts.plan}
        '';
        github-apply =
          mkGithubCommand "github-apply" "OpenTofu apply for the GitHub repository settings (asks to confirm)"
            ''
              ${lib.getExe scripts.apply}
            '';
      };

      devshells.default.commands =
        map
          (name: {
            inherit name;
            help = config.packages.${name}.meta.description;
            command = ''exec nix run "$(git rev-parse --show-toplevel)#${name}" -- "$@"'';
          })
          [
            "github-plan"
            "github-apply"
          ];
    };
}
