diff --git a/src/serve/tool_call_parser.cpp b/src/serve/tool_call_parser.cpp
index e541d96..dcdaf18 100644
--- a/src/serve/tool_call_parser.cpp
+++ b/src/serve/tool_call_parser.cpp
@@ -187,7 +187,14 @@ bool parse_parameter(std::string_view inner, std::size_t& pos, Json& args,
             // retaining the tag payload as a string is the only unambiguous interpretation.
             args[key] = value;
         } else {
-            Json parsed = Json::parse(value, nullptr, false);
+            // Qwen writes Python literals (True/False/None) for some tool parameters; the
+            // spelling is unambiguous, so map it to JSON rather than dropping the whole call.
+            const std::string trimmed = trim_ascii(value);
+            const std::string literal = trimmed == "True"    ? "true"
+                                        : trimmed == "False" ? "false"
+                                        : trimmed == "None"  ? "null"
+                                                             : value;
+            Json parsed = Json::parse(literal, nullptr, false);
             if (parsed.is_discarded()) { return false; }
             args[key] = std::move(parsed);
         }
